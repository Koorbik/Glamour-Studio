# ========================================
# Docker Environment Configuration
# ========================================
# Copy this file to .env.docker and fill in your actual values
# All marked as (Required) must be configured for the app to work properly

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
# Automatically created by Docker - customize if needed
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=service_db

# ========================================
# Security Configuration (Required)
# ========================================
# JWT Secret: Generate a secure random string (minimum 64 characters)
# You can generate one using: openssl rand -base64 64
JWT_SECRET_KEY=your_jwt_secret_key_here_at_least_64_characters_long_please_change_this
JWT_EXPIRATION=86400000

# ========================================
# Email Configuration (Required)
# ========================================
# Gmail SMTP for sending verification emails and notifications
# IMPORTANT: Use Gmail App Password, not your regular password
# Create App Password: https://myaccount.google.com/apppasswords
SUPPORT_EMAIL=your_email@gmail.com
APP_PASSWORD=your_16_character_gmail_app_password

# ========================================
# Google OAuth Configuration (Optional)
# ========================================
# Required for Google Sign-In and Google Calendar integration
# Get credentials from: https://console.cloud.google.com/
# Leave empty if not using Google features
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_SECRET=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_FRONTEND_CLIENT_ID=

# ========================================
# Facebook OAuth Configuration (Optional)
# ========================================
# Required for Facebook Sign-In
# Get credentials from: https://developers.facebook.com/
# Leave empty if not using Facebook login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ========================================
# PayU Payment Gateway (Optional)
# ========================================
# Required only if you want to enable payment functionality
# Sandbox (Testing): https://secure.snd.payu.com/
# Production: https://secure.payu.com/
# Leave empty if not using payment features

# PayU API Credentials
PAYU_BASE_URL=https://secure.snd.payu.com
PAYU_OAUTH_CLIENT_ID=
PAYU_OAUTH_CLIENT_SECRET=
PAYU_POS_ID=
PAYU_SECOND_KEY_MD5=

# PayU Callback URLs
# PAYU_NOTIFY_URL: Where PayU sends payment status notifications
# PAYU_CONTINUE_URL: Where user is redirected after payment
PAYU_NOTIFY_URL=http://localhost:8080/api/payments/notify
PAYU_CONTINUE_URL=http://localhost:4200/dashboard

# ========================================
# Spring Configuration
# ========================================
# Profile 'dev' uses PostgreSQL (for Docker)
# Do not change unless you know what you're doing
SPRING_PROFILES_ACTIVE=dev
